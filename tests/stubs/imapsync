#!/usr/bin/env bash
set -Eeuo pipefail
: "${MAILUOPS_STUB_DIR:?}"
if [[ ${1:-} == --version ]]; then
	printf 'imapsync stub 2.290\n'
	exit 0
fi
if [[ ${1:-} == --help ]]; then
	printf '%s\n' \
		--host1 --host2 --port1 --port2 --user1 --user2 --passfile1 --passfile2 \
		--ssl1 --ssl2 --sslargs1 --sslargs2 --timeout1 --timeout2 --justlogin \
		--dry --justfolders --nofoldersizes --nofoldersizesatend: --subscribe \
		--resyncflags --syncinternaldates --noexpunge1 --noexpunge2 --nouidexpunge2 \
		--tmpdir --pidfile --pidfilelocking --logdir --logfile --noreleasecheck --automap --f1f2
	exit 0
fi
{
	printf 'imapsync'
	for arg in "$@"; do printf '\t%q' "$arg"; done
	printf '\n'
} >>"$MAILUOPS_STUB_DIR/imapsync.argv"
phase=sync
logdir=
logfile=
args=("$@")
while [[ $# -gt 0 ]]; do
	case $1 in
	--justlogin) phase=login ;;
	--justfolders) phase=folders ;;
	--logdir)
		logdir=${2:-}
		shift
		;;
	--logfile)
		logfile=${2:-}
		shift
		;;
	esac
	shift
done
if [[ -n $logdir && -n $logfile ]]; then
	printf 'imapsync stub private log for %s\n' "$phase" >"$logdir/$logfile"
fi
if [[ ${IMAPSYNC_CHMOD_CA_AFTER_LOGIN:-0} == 1 && $phase == login ]]; then
	for arg in "${args[@]}"; do
		case $arg in
		SSL_ca_file=*) chmod 666 -- "${arg#SSL_ca_file=}" ;;
		esac
	done
fi
printf 'imapsync stub phase %s\n' "$phase"
if [[ -n ${IMAPSYNC_OUTPUT_LINES:-} ]]; then
	for ((i = 0; i < IMAPSYNC_OUTPUT_LINES; i++)); do
		printf 'imapsync noisy line %05d abcdefghijklmnopqrstuvwxyz abcdefghijklmnopqrstuvwxyz\n' "$i"
	done
fi
if [[ -n ${IMAPSYNC_CHILD_MARKER:-} && $phase == "${IMAPSYNC_CHILD_MARKER_PHASE:-sync}" ]]; then
	(
		trap 'printf "%s\n" terminated >"$IMAPSYNC_CHILD_MARKER"; exit 0' INT TERM HUP
		printf '%s\n' "$$" >"$IMAPSYNC_CHILD_MARKER.ready"
		while :; do sleep 1; done
	) &
	child=$!
	wait "$child"
fi
if [[ -n ${IMAPSYNC_SLEEP:-} ]]; then sleep "$IMAPSYNC_SLEEP"; fi
case $phase in
login) exit "${IMAPSYNC_STATUS_LOGIN:-0}" ;;
folders) exit "${IMAPSYNC_STATUS_FOLDERS:-0}" ;;
sync) exit "${IMAPSYNC_STATUS_SYNC:-0}" ;;
esac
